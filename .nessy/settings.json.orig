{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(npm test)",
      "Bash(node --check *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(which *)"
    ]
  },
  "experimental": {
    "lsp": true
  },
  "$version": 3
}
