{
    "manifest_version": 3,
    "name": "BPMN differ for Gitlab",
    "version": "0.18.0",
    "description": "BPMN 2.0 schemas and DMN visual differ for Gitlab",
    "content_scripts": [
        {
            "matches": [
                "https://gitlab.example.com/*",
                "https://gitlab.com/*"
            ],
            "js": [
                "src/core/config.js",
                "src/core/models.js",
                "src/core/utils.js",
                "src/content/providers/repo-provider.js",
                "src/content/providers/ui-repo-provider.js",
                "src/content/providers/gitlab/single-entry-cache.js",
                "src/content/providers/gitlab/gitlab-url-parser.js",
                "src/content/providers/gitlab/gitlab-dom-scraper.js",
                "src/content/providers/gitlab/master-commit-manager.js",
                "src/content/providers/gitlab/merged-mr-commit-resolver.js",
                "src/content/providers/gitlab/gitlab-repo-provider-base.js",
                "src/content/providers/gitlab/gitlab-repo-provider.js",
                "src/content/providers/gitlab/gitlab-ui-repo-provider.js",
                "src/content/providers/gitlab/gitlab-api-repo-provider.js",
                "src/content/providers/fallback-repo-provider.js",
                "src/content/providers/repo-provider-factory.js",
                "src/content/camunda-bpmn-moddle-manager.js",
                "src/content/page-reloader.js",
                "src/content/file-type-detector.js",
                "src/content/diff-params-builder.js",
                "src/content/app.js",
                "src/content/main.js"
            ]
        }
    ],
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "BPMN differ — update"
    },
    "background": {
        "service_worker": "src/background/update-service-worker.js"
    },
    "permissions": [
        "activeTab",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/popup/popup.html",
                "src/content/main.js",
                "src/core/utils.js",
                "src/differ/shared/diff-type.js",
                "src/differ/bpmn/condition-formatter.js",
                "src/differ/bpmn/canvas-viewport.js",
                "src/differ/bpmn/bpmn-xml-comparator.js",
                "src/differ/bpmn/diff-highlighter.js",
                "src/differ/bpmn/changes-table-view.js",
                "src/differ/bpmn/element-searcher.js",
                "src/differ/bpmn/search-panel.js",
                "src/differ/bpmn/properties-panel-highlighter.js",
                "src/differ/navigation/process-file-index.js",
                "src/differ/navigation/call-activity-locator.js",
                "src/differ/navigation/call-activity-navigator.js",
                "src/differ/navigation/caller-locator.js",
                "src/differ/navigation/handler-locator.js",
                "src/differ/navigation/handler-navigator.js",
                "src/differ/shared/differ-params.js",
                "src/differ/shared/diagram-versions.js",
                "src/differ/shared/branch-indicator.js",
                "src/differ/shared/differ-loading-overlay.js",
                "src/differ/shared/differ-empty-state.js",
                "src/differ/shared/update-indicator.js",
                "src/differ/bpmn/bpmn-differ-view.js",
                "src/differ/navigation/back-navigator.js",
                "src/differ/dmn/dmn-table-viewport.js",
                "src/differ/dmn/dmn-xml-comparator.js",
                "src/differ/dmn/dmn-diff-painter.js",
                "src/differ/dmn/dmn-differ-view.js",
                "src/differ/bpmn/bpmn-differ.js",
                "src/differ/dmn/dmn-differ.js",
                "src/differ/styles.css",
                "libs/bpmn-js/bpmn-modeler.production.min.js",
                "libs/bpmn-js/assets/bpmn-js.css",
                "libs/bpmn-js/assets/diagram-js.css",
                "libs/bpmn-js/assets/bpmn-font/css/bpmn-codes.css",
                "libs/bpmn-js/assets/bpmn-font/css/bpmn-embedded.css",
                "libs/bpmn-js/assets/bpmn-font/css/bpmn.css",
                "libs/bpmn-js/assets/bpmn-font/font/bpmn.eot",
                "libs/bpmn-js/assets/bpmn-font/font/bpmn.svg",
                "libs/bpmn-js/assets/bpmn-font/font/bpmn.ttf",
                "libs/bpmn-js/assets/bpmn-font/font/bpmn.woff",
                "libs/bpmn-js/assets/bpmn-font/font/bpmn.woff2",
                "libs/dmn-js/dmn-viewer.development.js",
                "libs/dmn-js/assets/dmn-js-decision-table-controls.css",
                "libs/dmn-js/assets/dmn-js-decision-table.css",
                "libs/dmn-js/assets/dmn-js-shared.css",
                "libs/dmn-js/assets/dmn-js-literal-expression.css",
                "libs/dmn-js/assets/dmn-font/css/dmn.css",
                "libs/dmn-js/assets/dmn-font/css/dmn-embedded.css",
                "libs/dmn-js/assets/dmn-font/css/dmn-codes.css",
                "libs/dmn-js/assets/dmn-font/font/dmn.svg",
                "libs/dmn-js/assets/dmn-font/font/dmn.woff",
                "libs/dmn-js/assets/dmn-font/font/dmn.eot",
                "libs/dmn-js/assets/dmn-font/font/dmn.woff2",
                "libs/dmn-js/assets/dmn-font/font/dmn.ttf",
                "libs/dmn-js/assets/dmn-js-drd.css",
                "libs/dmn-js/assets/diagram-js.css",
                "libs/bpmn-js-properties-panel/bpmn-js-properties-panel.umd.js",
                "libs/bpmn-js-properties-panel/assets/element-templates.css",
                "libs/bpmn-js-properties-panel/assets/properties-panel.css",
                "libs/camunda-bpmn-moddle/resources/camunda.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}